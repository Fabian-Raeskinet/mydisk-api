@using MyDisks.Frontend.Layout
@inject AuthenticationSettings AuthenticationSettings

<MudThemeProvider Theme="UiTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (AuthenticationSettings.IsConfigured)
{
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            @if (routeData.PageType == typeof(Pages.Authentication))
            {
                <RouteView RouteData="routeData" DefaultLayout="typeof(AuthenticationLayout)" />
            }
            else
            {
                <RequireSession>
                    <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
                    <FocusOnNavigate RouteData="routeData" Selector="h1" />
                </RequireSession>
            }
        </Found>
        <NotFound>
            <RequireSession>
                <LayoutView Layout="typeof(MainLayout)">
                    <PageTitle>MyDisk — Page introuvable</PageTitle>
                    <MudAlert Severity="Severity.Warning">Cette page n’existe pas.</MudAlert>
                    <MudButton Href="/" Color="Color.Primary" Class="mt-4">Revenir à la collection</MudButton>
                </LayoutView>
            </RequireSession>
        </NotFound>
    </Router>
}
else
{
    <LayoutView Layout="typeof(AuthenticationLayout)">
        <PageTitle>MyDisk — Connexion indisponible</PageTitle>
        <MudAlert Severity="Severity.Warning">La connexion est indisponible sur ce déploiement.</MudAlert>
    </LayoutView>
}
