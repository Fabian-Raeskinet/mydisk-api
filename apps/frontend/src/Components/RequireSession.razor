<AuthorizeView>
    <Authorized>@ChildContent</Authorized>
    <Authorizing>
        <LoadingIndicator Label="Vérification de la session…" />
    </Authorizing>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;
}
