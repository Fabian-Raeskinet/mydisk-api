<MudStack Spacing="4" Class="md-collection">
    <MudGrid Spacing="3" Class="md-page-heading align-center">
        <MudItem xs="12" md="8">
            <MudText Typo="Typo.overline" Class="md-page-kicker">Chaque disque a son histoire</MudText>
            <MudText Typo="Typo.h3" HtmlTag="h1">Ma collection.</MudText>
            <MudText Typo="Typo.body1" Class="md-page-subtitle">
                Vos découvertes, vos classiques, vos prochains coups de cœur.
            </MudText>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@Busy" OnClick="OnCreate">
                    Ajouter un disque
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="0" Class="pa-6 pa-md-8 md-collection-banner">
        <MudStack Spacing="2" Class="md-banner-copy">
            <MudText Typo="Typo.overline" Class="md-banner-kicker">Le plaisir de collectionner</MudText>
            <MudText Typo="Typo.h4" HtmlTag="h2">Une collection qui vous ressemble.</MudText>
            <MudText Typo="Typo.body1">Un disque, une rencontre, une histoire à partager.</MudText>
        </MudStack>
        <div class="md-banner-record" aria-hidden="true"></div>
    </MudPaper>

    <MudGrid Spacing="3" Class="md-collection-stats">
        <MudItem xs="12" sm="4">
            <MudPaper Outlined="true" Class="pa-4 md-stat-card">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Rounded="true" Class="md-stat-icon md-stat-discs">
                        <MudIcon Icon="@Icons.Material.Outlined.Album" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4">@Disks.Count.ToString("00")</MudText>
                        <MudText Typo="Typo.body2">Disques dans la collection</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Outlined="true" Class="pa-4 md-stat-card">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Rounded="true" Class="md-stat-icon md-stat-artists">
                        <MudIcon Icon="@Icons.Material.Outlined.Person" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4">@ArtistCount.ToString("00")</MudText>
                        <MudText Typo="Typo.body2">Artistes associés</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Outlined="true" Class="pa-4 md-stat-card">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Rounded="true" Class="md-stat-icon md-stat-reviews">
                        <MudIcon Icon="@Icons.Material.Outlined.RateReview" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4">@PublishedReviewCount.ToString("00")</MudText>
                        <MudText Typo="Typo.body2">Avis publiés</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="2" Class="md-collection-toolbar align-center">
        <MudItem xs="12" md="4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h6" HtmlTag="h2">Tous les disques</MudText>
                <MudChip T="string" Size="Size.Small" Class="md-count-chip">@FilteredDisks.Count()</MudChip>
            </MudStack>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField T="string" Label="Rechercher un disque ou un artiste" Placeholder="Un disque, un artiste…"
                          @bind-Value="_search" Immediate="true" Clearable="true" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="10" sm="5" md="3">
            <MudSelect T="string" Label="Trier la collection" @bind-Value="_sort"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value='@("name")'>Titre : A → Z</MudSelectItem>
                <MudSelectItem T="string" Value='@("newest")'>Sortie : plus récents</MudSelectItem>
                <MudSelectItem T="string" Value='@("oldest")'>Sortie : plus anciens</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="2" sm="1" md="1">
            <MudTooltip Text="Actualiser la collection">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary"
                               Variant="Variant.Outlined" Disabled="@(Loading || Busy)" OnClick="OnRefresh"
                               aria-label="Actualiser la collection" />
            </MudTooltip>
        </MudItem>
    </MudGrid>

    @if (Loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Chargement de la collection" />
    }
    else if (LoadFailed)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            La collection est indisponible. Vérifiez que l’API est démarrée, puis actualisez la collection.
        </MudAlert>
    }
    else if (!FilteredDisks.Any())
    {
        <MudPaper Outlined="true" Class="pa-6">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.Album" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@(Disks.Count == 0 ? "Votre collection commence ici" : "Aucun disque trouvé")</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center">
                    @(Disks.Count == 0 ? "Ajoutez votre premier disque pour commencer." : "Essayez un autre titre ou un autre nom d’artiste.")
                </MudText>
                @if (Disks.Count == 0)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnCreate" Disabled="@Busy">
                        Ajouter mon premier disque
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" OnClick="ClearSearch">Effacer la recherche</MudButton>
                }
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="3" Class="md-disk-grid">
            @foreach (var disk in FilteredDisks)
            {
                <MudItem xs="12" sm="6" md="4" xl="3" @key="disk.Id">
                    <MudCard Outlined="true" Elevation="0" Class="md-disk-card">
                        <MudCardContent Class="md-art-wrap">
                            <AlbumArt Disk="disk" />
                        </MudCardContent>
                        <MudCardContent Class="md-disk-caption">
                            <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Spacing="2">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.h6" HtmlTag="h3">@disk.Name</MudText>
                                    <MudText Typo="Typo.body2">@(disk.Author?.Pseudonym ?? "Artiste non associé")</MudText>
                                </MudStack>
                                <MudText Typo="Typo.caption" Class="md-disk-year">
                                    @(disk.ReleaseDate?.Year.ToString() ?? "—")
                                </MudText>
                            </MudStack>
                        </MudCardContent>
                        <MudDivider Class="mx-4" />
                        <MudCardContent Class="md-disk-metadata">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Outlined.RateReview" Size="Size.Small" />
                                    <MudText Typo="Typo.caption">@CountReviews(disk) avis</MudText>
                                </MudStack>
                                @if (CountReviews(disk) > 0)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="md-disk-rating">
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" />
                                        <MudText Typo="Typo.caption">@FormatAverage(disk)</MudText>
                                    </MudStack>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption">À découvrir</MudText>
                                }
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions Class="md-disk-actions">
                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                       EndIcon="@Icons.Material.Filled.ArrowForward" Disabled="@Busy"
                                       OnClick="() => OnSelect.InvokeAsync(disk)" aria-label="@($"Ouvrir le disque {disk.Name}")">
                                Ouvrir le disque
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudStack>
