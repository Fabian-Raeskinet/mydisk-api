@page "/authentication/{Action}"
@inject NavigationManager Navigation

<PageTitle>MyDisk — Connexion</PageTitle>

@if (Action?.ToLowerInvariant() is RemoteAuthenticationActions.LogIn
    or RemoteAuthenticationActions.LogInCallback or RemoteAuthenticationActions.LogInFailed
    or RemoteAuthenticationActions.LogOut or RemoteAuthenticationActions.LogOutCallback
    or RemoteAuthenticationActions.LogOutFailed)
{
    <RemoteAuthenticatorView Action="@Action">
        <LoggingIn>
            <p role="status">Redirection vers la page de connexion…</p>
        </LoggingIn>
        <CompletingLoggingIn>
            <p role="status">Connexion en cours…</p>
        </CompletingLoggingIn>
        <LogInFailed>
            <MudAlert Severity="Severity.Error">La connexion a échoué.</MudAlert>
            <MudButton OnClick="RetryLogin" Color="Color.Primary" Class="mt-4">Réessayer</MudButton>
        </LogInFailed>
        <LogOut>
            <p role="status">Déconnexion en cours…</p>
        </LogOut>
        <CompletingLogOut>
            <p role="status">Finalisation de la déconnexion…</p>
        </CompletingLogOut>
        <LogOutFailed>
            <MudAlert Severity="Severity.Error">La déconnexion a échoué. Réessayez depuis la collection.</MudAlert>
            <MudButton Href="/" Color="Color.Primary" Class="mt-4">Revenir à la collection</MudButton>
        </LogOutFailed>
    </RemoteAuthenticatorView>
}
else
{
    <MudAlert Severity="Severity.Warning">Cette page de connexion n’existe pas.</MudAlert>
    <MudButton Href="/" Color="Color.Primary" Class="mt-4">Revenir à la collection</MudButton>
}

@code {
    [Parameter]
    public string? Action { get; set; }

    private void RetryLogin() => Navigation.NavigateToLogin(RemoteAuthenticationDefaults.LoginPath,
        new InteractiveRequestOptions { Interaction = InteractionType.SignIn, ReturnUrl = Navigation.BaseUri });
}
