@page "/profil"
@inject DiskApiClient Api

<PageTitle>MyDisk — Mon profil</PageTitle>

<section class="md-profile" aria-labelledby="profile-title">
    <MudText Typo="Typo.h3" HtmlTag="h1" id="profile-title" Class="mb-6">Mon profil</MudText>
    <AuthorizeView>
        <MudPaper Outlined="true" Class="pa-5 pa-sm-7">
            <dl class="md-profile-details">
                <div>
                    <dt>Nom d’utilisateur</dt>
                    <dd>@Display(context.User.Identity?.Name)</dd>
                </div>
                <div>
                    <dt>Prénom</dt>
                    <dd>@Display(context.User.FindFirst("given_name")?.Value)</dd>
                </div>
                <div>
                    <dt>Nom</dt>
                    <dd>@Display(context.User.FindFirst("family_name")?.Value)</dd>
                </div>
                <div>
                    <dt>Adresse e-mail</dt>
                    <dd>@Display(context.User.FindFirst("email")?.Value)</dd>
                </div>
            </dl>
        </MudPaper>
        <MudPaper Outlined="true" Class="pa-5 pa-sm-7 mt-4">
            <details class="md-profile-claims">
                <summary>Claims de la session (débogage)</summary>
                <ClaimsTable Claims="context.User.Claims.Select(claim => new ClaimResult(claim.Type, claim.Value))" />
            </details>
        </MudPaper>
        <MudPaper Outlined="true" Class="pa-5 pa-sm-7 mt-4">
            <details class="md-profile-claims">
                <summary>Claims validés par l’API</summary>
                <MudStack Spacing="3" Class="mt-3">
                    <div>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CheckApiSessionAsync" Disabled="_checkingApiSession">
                            Vérifier la connexion à l’API
                        </MudButton>
                    </div>
                    @if (_checkingApiSession)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Vérification de la session par l’API" />
                    }
                    else if (_apiSessionError is not null)
                    {
                        <MudAlert Severity="Severity.Error">@_apiSessionError</MudAlert>
                    }
                    else if (_apiClaims is not null)
                    {
                        <MudAlert Severity="Severity.Success">L’API a validé votre jeton d’accès.</MudAlert>
                        <ClaimsTable Claims="_apiClaims" />
                    }
                </MudStack>
            </details>
        </MudPaper>
    </AuthorizeView>
</section>

@code {
    private bool _checkingApiSession;
    private List<ClaimResult>? _apiClaims;
    private string? _apiSessionError;

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "Non renseigné" : value;

    private async Task CheckApiSessionAsync()
    {
        if (_checkingApiSession) return;

        _checkingApiSession = true;
        _apiClaims = null;
        _apiSessionError = null;

        try
        {
            _apiClaims = await Api.GetSessionClaimsAsync();
        }
        catch (ApiException ex)
        {
            _apiSessionError = ex.Message;
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or Microsoft.JSInterop.JSException)
        {
            _apiSessionError = "Impossible de vérifier la session. Réessayez.";
        }
        finally
        {
            _checkingApiSession = false;
        }
    }
}
