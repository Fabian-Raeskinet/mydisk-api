{
  "realm": "mydisk",
  "enabled": true,
  "displayName": "MyDisk",
  "loginTheme": "mydisk",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr"],
  "defaultLocale": "fr",
  "roles": {
    "client": {
      "mydisk-frontend": [
        {
          "name": "admin",
          "description": "View and archive reviews in MyDisk"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "mydisk-frontend",
      "name": "MyDisk",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5100/authentication/login-callback",
        "http://localhost:3000/authentication/login-callback",
        "https://localhost:8443/authentication/login-callback"
      ],
      "webOrigins": [
        "http://localhost:5100",
        "http://localhost:3000",
        "https://localhost:8443"
      ],
      "protocolMappers": [
        {
          "name": "mydisk-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mydisk-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "mydisk-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "mydisk-frontend",
            "claim.name": "mydisk_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5100/authentication/logout-callback##http://localhost:3000/authentication/logout-callback##https://localhost:8443/authentication/logout-callback"
      }
    }
  ]
}
